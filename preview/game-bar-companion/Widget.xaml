<Page
    x:Class="AchievementWatcher.GameBar.Widget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#17221D" Padding="24">
    <StackPanel VerticalAlignment="Center" Spacing="12">
      <TextBlock Text="Achievement Watcher" FontSize="24" FontWeight="SemiBold" Foreground="#F2C94C" />
      <TextBlock Text="Fullscreen notification companion" Foreground="#C7D4CE" />
      <TextBox x:Name="Token" Header="Pairing token" PlaceholderText="Paste the token shown in Achievement Watcher" />
      <Button Content="Connect" Click="Connect_Click" HorizontalAlignment="Left" />
      <TextBlock x:Name="Status" Text="Not connected" Foreground="#9DB2A8" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Page>
